{
  "name": "dealsdrop",
  "version": "1.0.0",
  "description": "Verified, affiliate-free Black Friday & Cyber Monday 2026 deals as structured data, validated by CI.",
  "scripts": {
    "validate": "node scripts/validate.mjs",
    "validate:strict": "node scripts/validate.mjs --strict",
    "build": "node scripts/build-readme.mjs",
    "build:check": "node scripts/build-readme.mjs --check",
    "check-links": "node scripts/check-links.mjs",
    "expire": "node scripts/expire.mjs",
    "test": "node scripts/validate.mjs && node scripts/build-readme.mjs --check && node scripts/selftest.mjs"
  },
  "author": "Naveen Choudhary (nick-choudhary)",
  "license": "MIT",
  "type": "module",
  "devDependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "js-yaml": "^5.5.0"
  },
  "private": true,
  "keywords": [
    "black-friday",
    "cyber-monday",
    "deals",
    "2026",
    "saas",
    "awesome-list"
  ],
  "engines": {
    "node": ">=20"
  }
}
